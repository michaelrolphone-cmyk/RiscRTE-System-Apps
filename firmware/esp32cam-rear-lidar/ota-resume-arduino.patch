+// This lane preserves the authenticated Update handle across TCP drops. The
+// callback advertises only the position written by the ESP, including its own
+// flash-sector buffer, so neither a lost TCP ACK nor a reconnect replays data.
+void ArduinoOTAClass::_runResumableUpdate() {
+    constexpr uint32_t sessionIdleMs = 120000;
+    constexpr uint32_t connectionIdleMs = 20000;
+    const auto imageSize = static_cast<uint32_t>(_size);
+    uint32_t offset = 0;
+    uint32_t lastWrite = millis();
+    uint8_t buffer[1460];
+    while (millis() - lastWrite < sessionIdleMs) {
+        WiFiClient client;
+        if (!client.connect(_ota_ip, _ota_port, 2000)) {
+            delay(250);
+            continue;
+        }
+        client.setNoDelay(true);
+        if (!client.printf("RESUME %u\n", offset)) {
+            client.stop();
+            delay(250);
+            continue;
+        }
+        const uint32_t connectedAt = millis();
+        const uint32_t startingOffset = offset;
+        while (offset < imageSize) {
+            int length = client.available();
+            if (length <= 0) {
+                const uint32_t start = offset == startingOffset ? connectedAt : lastWrite;
+                if (!client.connected() || millis() - start >= connectionIdleMs ||
+                    millis() - lastWrite >= sessionIdleMs)
+                    break;
+                delay(2);
+                continue;
+            }
+            if (static_cast<size_t>(length) > sizeof(buffer))
+                length = sizeof(buffer);
+            if (static_cast<uint32_t>(length) > imageSize - offset)
+                length = imageSize - offset;
+            const int count = client.read(buffer, length);
+            if (count <= 0)
+                break;
+            const size_t written = Update.write(buffer, count);
+            if (written != static_cast<size_t>(count)) {
+                Update.abort();
+                client.stop();
+                if (_error_callback)
+                    _error_callback(OTA_RECEIVE_ERROR);
+                return;
+            }
+            offset += written;
+            lastWrite = millis();
+            if (_progress_callback)
+                _progress_callback(offset, imageSize);
+        }
+        if (offset == imageSize) {
+            if (!Update.end()) {
+                client.stop();
+                if (_error_callback)
+                    _error_callback(OTA_END_ERROR);
+                return;
+            }
+            client.print("OK\n");
+            client.stop();
+            if (_end_callback)
+                _end_callback();
+            if (_rebootOnSuccess) {
+                delay(110);
+                ESP.restart();
+            }
+            return;
+        }
+        client.stop();
+        delay(250);
+    }
+    Update.abort();
+    if (_error_callback)
+        _error_callback(OTA_RECEIVE_ERROR);
+}
