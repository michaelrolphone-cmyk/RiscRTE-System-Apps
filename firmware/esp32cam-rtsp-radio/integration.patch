+struct CaptureJsonAllocator {
+  void *allocate(size_t size){return heap_caps_malloc(size,MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);}
+  void deallocate(void *ptr){heap_caps_free(ptr);}
+  void *reallocate(void *ptr,size_t size){return heap_caps_realloc(ptr,size,MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);}
+};
+// One response binds actual camera-driver capture time and sensor samples.
+void handle_synchronized_capture() {
+  if (camera_init_result != ESP_OK) { web_server.send(503,"text/plain","Camera unavailable");return; }
+  // Hold a separate SDK buffer; do not overwrite the RTSP streamer's JPEG copy.
+  std::unique_ptr<camera_fb_t,void(*)(camera_fb_t *)> fb(esp_camera_fb_get(),esp_camera_fb_return);
+  if (!fb || fb->format!=PIXFORMAT_JPEG) {web_server.send(503,"text/plain","Camera frame unavailable");return;}
+  const uint64_t captureUs=static_cast<uint64_t>(fb->timestamp.tv_sec)*1000000ULL+fb->timestamp.tv_usec;
+  if (!captureUs) { web_server.send(503,"text/plain","Capture timestamp unavailable");return; }
+  BasicJsonDocument<CaptureJsonAllocator> document(65536);
+  JsonObject packet=document.to<JsonObject>();
+  if(!radio_telemetry::writeFrameJson(packet,captureUs)) {web_server.send(503,"text/plain","Sensor metadata unavailable");return;}
+  packet["width"]=fb->width;packet["height"]=fb->height;
+  packet["capture_timestamp_semantics"]="camera_driver_first_dma_buffer";
+  if(document.overflowed()) { web_server.send(503,"text/plain","Capture metadata allocation failed");return; }
+  packet["served_monotonic_us"]=static_cast<uint64_t>(esp_timer_get_time());
+  const size_t metadataSize=measureJson(document);
+  uint8_t *metadata=static_cast<uint8_t *>(heap_caps_malloc(metadataSize+1,MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT));
+  if(!metadata){web_server.send(503,"text/plain","Capture metadata memory unavailable");return;}
+  serializeJson(document,reinterpret_cast<char *>(metadata),metadataSize+1);
+  const String first="--biomeframe\r\nContent-Type: application/json\r\nContent-Length: "+String(metadataSize)+"\r\n\r\n";
+  const String second="\r\n--biomeframe\r\nContent-Type: image/jpeg\r\nContent-Length: "+String(fb->len)+"\r\n\r\n";
+  const String end="\r\n--biomeframe--\r\n";
+  web_server.sendHeader("Cache-Control","no-store");
+  web_server.setContentLength(first.length()+metadataSize+second.length()+fb->len+end.length());
+  web_server.send(200,"multipart/mixed; boundary=biomeframe","");
+  auto client=web_server.client();
+  client.write(first.c_str(),first.length());client.write(metadata,metadataSize);
+  client.write(second.c_str(),second.length());client.write(fb->buf,fb->len);client.write(end.c_str(),end.length());
+  heap_caps_free(metadata);
 }
 
