+ if(which("availability-unavailable"))availability=RISC_KEY_VALUE_UNAVAILABLE;
+ if(which("availability-pending"))availability=RISC_KEY_VALUE_RECONCILIATION_PENDING;
+ if(which("availability-conflict"))availability=RISC_KEY_VALUE_CONFLICT;
+ runtime.acquire=retained_acquire;runtime.release=retained_release;runtime.resident_shell=selected_resident;
+ assert(app_module_init()==0);in_main=true;const t5_app_api_v1 *api=t5_app_get_api(1);assert(api&&!retained);
+ bool ui=which("save-local")||which("save-utc")||which("missing-basis")||which("save-edited");
+ bool ok=false;
+ if(ui) {
+  api->settings_render(0,1);inputs();retained_navigation_frame=0;next_at=5;
+  if(which("save-edited")){nav(RISC_NAV_CONFIRM);nav(RISC_NAV_RIGHT);nav(RISC_NAV_BACK);expected_epoch=1800041696;}
+  save_time(false);next_at+=40;end_app();
+  ok=api->settings_activate(0,0)==T5_APP_SETTING_UPDATED;
+  assert(ok&&!settings_availability_draft);verify_success(false);
+ } else {
+  assert(settings_atomic_begin("rtc_basis"));snt_load_basis();assert(snt_load_zone());
+  portable_timezone_civil civil;assert(!portable_timezone_utc_to_local(&snt_rule,expected_epoch,&civil,NULL));
+  settings_draft=(twatch_rtc_time_v1){(uint16_t)civil.year,civil.month,civil.day,civil.weekday,civil.hour,civil.minute,civil.second};
+  int fold=-1;
+  if(!strncmp(test_name,"fold-",5)) {settings_draft=(twatch_rtc_time_v1){2026,11,1,0,1,30,0};fold=which("fold-first")?0:1;expected_epoch=1793518200+(fold?3600:0);}
+  if(which("gap"))settings_draft=(twatch_rtc_time_v1){2026,3,8,0,2,30,0};
+  if(which("range"))settings_draft=(twatch_rtc_time_v1){2038,1,20,3,12,0,0};
+  if(which("stale-time-before"))++revision;
+  if(which("atomic-cancelled"))fault_status=RISC_ATOMIC_CANCELLED;
+  if(which("atomic-uncertain"))fault_status=RISC_ATOMIC_UNCERTAIN;
+  if(which("atomic-io"))fault_status=RISC_ATOMIC_IO;
+  if(which("atomic-capacity"))fault_status=RISC_ATOMIC_CAPACITY;
+  api->settings_render(0,1);sv_switch(SV_FIELDS);inputs();
+  ok=snt_save(fold);
+  bool success=which("rtc-tick")||!strncmp(test_name,"fold-",5);
+  assert(ok==success);
+  if(success)verify_success(which("rtc-tick"));
+  bool no_clock=which("gap")||which("range")||which("stale-time-before")||!strncmp(test_name,"availability-",13)||which("native-control-absent")||which("rtc-acquire-false");
+  if(no_clock)assert(!rtc_writes&&!seeds&&!submitted);
+  else assert(rtc_writes==1);
+  if(!success)assert(snt_last_result.metadata_outcome!=PORTABLE_SET_TIME_CONFIRMED);
+  if(which("rtc-write-false")||which("rtc-read-false")||which("rtc-mismatch")||which("rtc-release-false"))assert(!seeds&&!submitted);
+  if(which("native-seed-io")||which("native-seed-context")||which("native-readback-io")||which("native-readback-mismatch")||which("native-release-false"))assert(seeds==1&&!submitted);
+  if(which("stale-time-during"))assert(seeds==1&&!submitted&&strstr(snt_status_text,"stale"));
+  if(fault_status)assert(submitted==1&&seeds==1&&snt_last_result.metadata_write_accepted);
