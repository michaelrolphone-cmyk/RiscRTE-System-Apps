+ #ifdef PORTABLE_SETTINGS_AVAILABILITY
+ if(!settings_availability_refresh())return RISC_KEY_VALUE_CONTEXT;
+ if(!portable_settings_availability_available(&settings_availability))return RISC_KEY_VALUE_NOT_FOUND;
+#endif
