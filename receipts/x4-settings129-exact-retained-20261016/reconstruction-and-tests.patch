+  rc=settings_atomic_api->state(settings_atomic_api->context,&state);
+  if(!settings_atomic_guard(NULL))return RISC_KEY_VALUE_CONTEXT;
+  if(!rc&&!portable_preference_atomic_state_valid(&state))rc=RISC_ATOMIC_INVALID;
