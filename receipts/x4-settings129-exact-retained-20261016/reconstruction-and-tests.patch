+if a.sanitize:flags+=['-fsanitize=address,undefined','-fno-sanitize-recover=all','-fno-omit-frame-pointer','-no-pie']
+sources=[ROOT/'test/native_apps/retained_rtc_save_test.c',ROOT/'Apps/settings_native_entry.c',*[ROOT/s for s in builder.NATIVE_TIME_SOURCES]]
+exe=a.output/'retained-rtc';cmd=[os.environ.get('CC','cc'),'-std=c11','-O1','-g','-Wall','-Wextra','-Werror','-Wno-unused-function',*flags,'-I'+str(a.target.resolve()/'native-time-sdk/include'),'-I'+str(ROOT/'lib/NativeApps/include'),*map(str,sources),'-Wl,--wrap=free','-o',str(exe)]
+subprocess.run(cmd,check=True)
+results=[]
+for case in a.case or '''save-local save-utc missing-basis save-edited rtc-tick fold-first fold-second fold-second-utc gap range rtc-acquire-false rtc-write-false rtc-read-false rtc-release-false rtc-mismatch native-control-absent native-seed-io native-seed-context native-readback-io native-readback-mismatch native-release-false stale-time-before stale-time-during atomic-cancelled atomic-uncertain atomic-io atomic-capacity collect-error collect-retained submit-dirty-refusal availability-unavailable availability-pending availability-conflict'''.split():
