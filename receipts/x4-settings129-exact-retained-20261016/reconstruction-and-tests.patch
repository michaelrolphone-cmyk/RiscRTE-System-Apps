+ if(!rc)rc=settings_atomic_api->get(settings_atomic_api->context,revision,key,out,cap,size);
+ if(!settings_atomic_guard(NULL))return RISC_KEY_VALUE_CONTEXT;
+ if(rc==RISC_ATOMIC_RETAINED || (rc>RISC_ATOMIC_CANCELLED||rc<RISC_ATOMIC_RETAINED)) {
+  settings_atomic_result(RISC_ATOMIC_RETAINED);return RISC_KEY_VALUE_CONTEXT;
+ }
+ return rc==RISC_ATOMIC_OK?RISC_KEY_VALUE_OK:rc==RISC_ATOMIC_NOT_FOUND?RISC_KEY_VALUE_NOT_FOUND:
+  rc==RISC_ATOMIC_BUSY||rc==RISC_ATOMIC_STALE?RISC_KEY_VALUE_BUSY:
+  rc==RISC_ATOMIC_BUFFER_SMALL?RISC_KEY_VALUE_BUFFER_SMALL:RISC_KEY_VALUE_IO;
+}
+static int32_t settings_atomic_deny_put(void *c,const char *key,const void *data,uint32_t size) {
+ (void)c;(void)key;(void)data;(void)size;return RISC_KEY_VALUE_CONTEXT;
+}
+static bool settings_atomic_open(void) {
+ #ifdef PORTABLE_SETTINGS_AVAILABILITY
+ if(!settings_availability.api&&!portable_settings_availability_open(&settings_availability,rt,1)){
+  settings_atomic_result(RISC_ATOMIC_RETAINED);return false;
+ }
+ settings_availability_draft=settings_availability_temporary=settings_availability_discard=false;
+#endif
+ settings_atomic_grant=(risc_runtime_capability_v1){.struct_size=sizeof(settings_atomic_grant)};
+ settings_atomic_api=NULL;settings_atomic_edit=(portable_preference_atomic){0};
+ settings_atomic_running=settings_atomic_exit=false;settings_atomic_status=RISC_ATOMIC_OK;
+ if(!rt->acquire(RISC_KEY_VALUE_ATOMIC_CAPABILITY,RISC_KEY_VALUE_ATOMIC_API_V1,
+   PORTABLE_PREFERENCE_NAMESPACE,&settings_atomic_grant))return !native_custody_retained;
+ if(native_custody_retained)return false;
+ if(settings_atomic_grant.struct_size!=sizeof(settings_atomic_grant)||!settings_atomic_grant.slot||
+    !settings_atomic_grant.generation||!portable_preference_atomic_api_valid(settings_atomic_grant.api)) {
+  settings_atomic_result(RISC_ATOMIC_RETAINED);return false;
+ }
+ settings_atomic_api=settings_atomic_grant.api;
+ settings_atomic_view=(risc_key_value_v1){1,sizeof(settings_atomic_view),NULL,settings_atomic_get,settings_atomic_deny_put};
+ settings_store=&settings_atomic_view;return true;
+}
+static bool settings_atomic_begin(const char *key) {
+ settings_atomic_exit=false;settings_atomic_submission_accepted=false;
+#ifdef PORTABLE_SETTINGS_AVAILABILITY
+ if(!settings_availability_refresh())return false;
+ if(!settings_atomic_api){settings_message="Settings editing unavailable; reopen";return false;}
+ settings_availability_draft=true;settings_availability_discard=false;
+ settings_availability_temporary=!portable_settings_availability_available(&settings_availability);
+ if(settings_availability_temporary) {
+  settings_atomic_edit=(portable_preference_atomic){0};
+  if(!portable_preference_atomic_key(key))return false;
+  memcpy(settings_atomic_edit.key,key,strlen(key)+1);
+  settings_atomic_status=PORTABLE_PREFERENCE_READY;return true;
+ }
+#endif
+ int rc=portable_preference_atomic_begin(&settings_atomic_edit,settings_atomic_api,key,
+  PORTABLE_PREFERENCE_USER,settings_atomic_guard,NULL);
+ settings_atomic_result(rc);
+ if(rc!=PORTABLE_PREFERENCE_READY){settings_message=settings_atomic_message(rc);
+#ifdef PORTABLE_SETTINGS_AVAILABILITY
+ settings_availability_draft=false;
+#endif
+ return false;}
+ return true;
+}
+static bool settings_atomic_save(const char *key,const void *value,uint32_t size,const char **message);
+/* Called before ANY normal finalizer teardown. A missing terminal receipt or
+ * failed release keeps the grant, token, staging and entire invocation live. */
+static bool settings_atomic_close(void) {
+ if(native_custody_retained)return false;
+#ifdef PORTABLE_SETTINGS_AVAILABILITY
+ if(settings_availability_draft)return false;
+#endif
+ if(settings_atomic_edit.token) {
+  int rc=portable_preference_atomic_cancel(&settings_atomic_edit);
+  if(rc==RISC_ATOMIC_PENDING || rc==RISC_ATOMIC_RETAINED) {
+   settings_atomic_result(RISC_ATOMIC_RETAINED);return false;
+  }
+ }
+ if(settings_atomic_running){settings_atomic_result(RISC_ATOMIC_RETAINED);return false;}
+ if(settings_atomic_grant.api&&!rt->release(&settings_atomic_grant))return false;
+ if(native_custody_retained)return false;
+ #ifdef PORTABLE_SETTINGS_AVAILABILITY
+ if(!portable_settings_availability_close(&settings_availability,rt))return false;
+#endif
+ settings_atomic_api=NULL;settings_store=NULL;settings_atomic_edit=(portable_preference_atomic){0};return true;
+}
diff --git a/lib/PortableApps/src/settings_atomic_save.inc b/lib/PortableApps/src/settings_atomic_save.inc
new file mode 100644
index 0000000..2bd1afc
--- /dev/null
+++ b/lib/PortableApps/src/settings_atomic_save.inc
@@ -0,0 +1,52 @@
+/* The modal remains an ordinary input/display controller while Native owns
+ * the copied operation. No resident host handoff crosses an owned token. */
+static bool settings_atomic_save(const char *key,const void *value,uint32_t size,const char **message) {
+#ifdef PORTABLE_SETTINGS_AVAILABILITY
+ if(!settings_availability_save_ready(message)){settings_atomic_status=RISC_ATOMIC_BUSY;return false;}
+#endif
+ int rc=strcmp(key,settings_atomic_edit.key)?RISC_ATOMIC_INVALID:
+  portable_preference_atomic_prepare(&settings_atomic_edit,value,size);
+ if(rc!=PORTABLE_PREFERENCE_READY){*message=settings_atomic_message(rc);return false;}
+ settings_atomic_running=true;*message="Saving locally - Back cancels";settings_view_redraw();
+ bool cancel=false;
+ for(;;) {
+  if(!settings_atomic_guard(NULL)){rc=RISC_ATOMIC_RETAINED;break;}
+  bool accepting=!cancel&&!settings_atomic_edit.token;
+  rc=cancel?portable_preference_atomic_cancel(&settings_atomic_edit):
+    settings_atomic_edit.token?portable_preference_atomic_collect(&settings_atomic_edit):
+    portable_preference_atomic_submit(&settings_atomic_edit);
+  if(accepting&&rc==RISC_ATOMIC_PENDING)settings_atomic_submission_accepted=true;
+  if(rc!=RISC_ATOMIC_PENDING&&rc!=PORTABLE_PREFERENCE_READY)break;
+  if(cancel) {
+   /* poll returns immediately on a host exit request; this checked scheduler
+    * delay lets the native worker finish without replaying normal UI work. */
+   rt->yield_ms(1);continue;
+  }
+  t5_app_input_t input;
+  if(!poll(&input,20)) {
+   if(!settings_atomic_guard(NULL)){rc=RISC_ATOMIC_RETAINED;break;}
+   cancel=true;settings_atomic_exit=true;
+  } else if(input.exit_requested||(input.buttons&T5_APP_BUTTON_BACK)) {
+   cancel=true;settings_atomic_exit=true;
+  }
+ }
+ settings_atomic_running=false;settings_atomic_result(rc);
+#ifdef PORTABLE_SETTINGS_AVAILABILITY
+ /* Cancelling a save does not discard the editor's RAM draft. The accepted
+  * attempt cannot be replayed; keep it visible until explicit Discard. */
+ if(rc!=RISC_ATOMIC_RETAINED)settings_atomic_exit=false;
+#endif
+ *message=rc==RISC_ATOMIC_OK?"Saved locally; SD backup not confirmed":settings_atomic_message(rc);
+ return rc==RISC_ATOMIC_OK;
+}
+static bool settings_atomic_choice(const char *key,uint8_t tag,unsigned value,unsigned count,const char **message) {
+ if(value>=count){*message="Invalid selection";return false;}
+ const uint8_t bytes[]={tag,1,(uint8_t)value,(uint8_t)(value^0xa5u)};
+ return settings_atomic_save(key,bytes,sizeof(bytes),message);
+}
+static bool settings_atomic_timer(uint32_t milliseconds,const char **message) {
+ if(milliseconds<5000u||milliseconds>3600000u||milliseconds%1000u){*message="Invalid timer";return false;}
+ unsigned seconds=milliseconds/1000u;
+ const uint8_t bytes[]={0x54,1,(uint8_t)seconds,(uint8_t)(seconds>>8),(uint8_t)(seconds^(seconds>>8)^0xa5u)};
+ return settings_atomic_save(PORTABLE_SLEEP_IDLE_KEY,bytes,sizeof(bytes),message);
+}
diff --git a/lib/PortableApps/src/settings_availability.inc b/lib/PortableApps/src/settings_availability.inc
new file mode 100644
index 0000000..8b31713
--- /dev/null
+++ b/lib/PortableApps/src/settings_availability.inc
@@ -0,0 +1,55 @@
+/* A temporary draft is never rebased onto a newly found source. Keep its data
+ * grant until explicit Save or Discard; host handoff is BUSY during the edit. */
+static unsigned settings_availability_return_page;
+static bool settings_availability_editing(void) {return settings_availability_draft;}
+static bool settings_availability_filter(t5_app_input_t *input) {
+ if(!settings_availability_draft||settings_atomic_running||settings_atomic_edit.token)return false;
+ bool leave=input->exit_requested||(input->buttons&T5_APP_BUTTON_BACK)||home_pending||crown_pending||
+  (sv_page==SV_FIELDS&&editor_field==7&&(input->buttons&T5_APP_BUTTON_CONFIRM));
+ if(settings_availability_discard) {
+  bool discard=!!(input->buttons&T5_APP_BUTTON_CONFIRM);
+  bool keep=!!(input->buttons&T5_APP_BUTTON_BACK)||home_pending||crown_pending;
+  home_pending=crown_pending=false;navigation_pending=0;
+  memset(input,0,sizeof(*input));
+  if(discard||keep) {
+   settings_availability_discard=false;
+   if(discard)settings_availability_draft=false;
+   sv_switch(settings_availability_return_page);
+   if(discard){input->buttons=T5_APP_BUTTON_BACK;input->exit_requested=true;}
+  }
+  return true;
+ }
+ /* Back inside the date value selector or time-zone cities is navigation,
+  * not an editor exit. Physical Home still asks before any handoff. */
+ if(!input->exit_requested&&!home_pending&&!crown_pending&&
+    (sv_page==SV_VALUE||sv_page==SV_TIMEZONE_CITIES))return false;
+ if(!leave)return false;
+ settings_availability_return_page=sv_page;settings_availability_discard=true;
+ home_pending=crown_pending=false;navigation_pending=0;memset(input,0,sizeof(*input));
+ sv_switch(SV_DISCARD);return true;
+}
+static uint8_t settings_availability_activate(void) {
+ if(settings_availability_draft||settings_atomic_owned())return T5_APP_SETTING_NO_CHANGE;
+ if(!settings_availability_refresh())return T5_APP_SETTING_ERROR;
+ sv_switch(SV_STORAGE);bool armed=false;t5_app_input_t input;
+ while(poll(&input,20)) {
+  if(input.exit_requested||(input.buttons&T5_APP_BUTTON_BACK))break;
+  if(!input.buttons&&!input.tapped){armed=true;continue;}
+  if(!armed)continue;
+  armed=false;
+  if(input.buttons&T5_APP_BUTTON_CONFIRM) {
+   /* The same explicit zero-draft boundary closes all Settings-owned data.
+    * A provider or resident host may still hold another namespace-1 grant. */
+   if(!settings_atomic_close()){portable_adapter_retain();return T5_APP_SETTING_ERROR;}
+   rt->yield_ms(1);
+   if(native_custody_retained||!settings_atomic_open())return T5_APP_SETTING_ERROR;
+   settings_time_format_load();
+   settings_message=settings_availability.state.availability==RISC_KEY_VALUE_RECONCILIATION_PENDING?
+     "Still pending: finish other edits, then clean Runtime restart":
+     portable_settings_availability_message(&settings_availability);
+   settings_view_redraw();
+  }
+ }
+ settings_message=portable_settings_availability_message(&settings_availability);
+ sv_switch(SV_ROOT);return T5_APP_SETTING_NO_CHANGE;
+}
