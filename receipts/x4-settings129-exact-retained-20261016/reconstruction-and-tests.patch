+ initial_basis_missing=which("missing-basis");configure_records();
+ memcpy(values[1],zone_record,zone_size);sizes[1]=zone_size;memcpy(values[4],flip_record,flip_size);sizes[4]=flip_size;memcpy(values[7],basis_record,basis_size);sizes[7]=basis_size;
