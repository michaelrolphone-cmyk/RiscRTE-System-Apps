+/* Exact reconstructed RTC/save sources with checked native, RTC, atomic and
+ * availability providers. First-Save cases enter settings_activate once;
+ * fault cases invoke the source-bound Save boundary once with an open draft. */
+#define RETAINED_RTC_FIXTURE
+#include "settings_availability_workflow_test.c"
+static bool retained_tick_read(void *ctx,twatch_rtc_time_v1 *out) {
+ bool ok=rtc_read(ctx,out);if(!ok||!which("rtc-tick"))return ok;
+ portable_timezone_civil c={out->year,out->month,out->day,out->hour,out->minute,out->second,out->weekday};
+ int64_t e;assert(!portable_timezone_civil_to_epoch(&c,&e));assert(!portable_timezone_epoch_to_civil(e+1,&c));
+ *out=(twatch_rtc_time_v1){(uint16_t)c.year,c.month,c.day,c.weekday,c.hour,c.minute,c.second};return true;
+}
+/* Navigation owns its own ordered provider frames. Raster capture may read
+ * touch many times between navigation polls, so indexing button edges by raw
+ * touch sample count silently drops scheduled presses. */
+static unsigned retained_navigation_frame;
+static bool retained_navigation_poll(void *ctx,risc_input_navigation_frame_v1 *out) {
+ (void)ctx;io();assert(retained_navigation_frame+1<sizeof(nav_buttons)/sizeof(nav_buttons[0]));
+ unsigned buttons=nav_buttons[++retained_navigation_frame];
+ *out=(risc_input_navigation_frame_v1){.buttons=buttons,.pressed=buttons};
+ return true;
+}
+static bool retained_acquire(const char *name,uint32_t version,uint64_t ns,risc_runtime_capability_v1 *out) {
+ bool ok=availability_acquire(name,version,ns,out);
+ if(ok&&!strcmp(name,"input.navigation")) {static risc_input_navigation_api_v1 api;api=*(const risc_input_navigation_api_v1 *)out->api;api.poll=retained_navigation_poll;out->api=&api;}
+ if(ok&&!strcmp(name,TWATCH_RTC_CAPABILITY)) {static twatch_rtc_api_v1 api;api=*(const twatch_rtc_api_v1 *)out->api;api.read=retained_tick_read;out->api=&api;}
+ return ok;
+}
+static bool retained_release(risc_runtime_capability_v1 *grant) {
+ if(which("native-release-false")&&leases[grant->slot].kind==K_CONTROL&&seeds){io();hidden=true;return false;}
+ return availability_release(grant);
+}
+static void verify_success(bool tick) {
+ static const uint8_t basis_local[12]={0x52,0x54,0x01,0x00,0x60,0x41,0x69,0x69,0x17,0xc9,0x89,0x20};
+ static const uint8_t basis_utc[12]={0x52,0x54,0x01,0x01,0x60,0x41,0x69,0x69,0x30,0xb9,0xfa,0xf5};
+ static const uint8_t basis_edited[12]={0x52,0x54,0x01,0x00,0xe0,0x74,0x4a,0x6b,0x0d,0x35,0xd8,0x76};
+ static const uint8_t basis_tick[12]={0x52,0x54,0x01,0x00,0x61,0x41,0x69,0x69,0xee,0x89,0x87,0x1b};
+ static const uint8_t basis_fold_first[12]={0x52,0x54,0x01,0x00,0x78,0xea,0xe6,0x6a,0x3c,0xfd,0xe6,0xa3};
+ static const uint8_t basis_fold_second[12]={0x52,0x54,0x01,0x00,0x88,0xf8,0xe6,0x6a,0xe2,0x60,0x68,0xed};
+ static const uint8_t basis_fold_utc[12]={0x52,0x54,0x01,0x01,0x88,0xf8,0xe6,0x6a,0x01,0xa3,0xd7,0x8a};
+ bool utc=which("save-utc")||which("fold-second-utc");
+ bool folded=!strncmp(test_name,"fold-",5),edited=which("save-edited");
+ twatch_rtc_time_v1 wanted={edited?2027:2026,folded?11:1,folded?1:15,folded?0:edited?5:4,
+  folded?(utc?8:1):(utc?19:12),folded?30:34,folded?0:56};
+ assert(written.year==wanted.year&&written.month==wanted.month&&written.day==wanted.day&&written.weekday==wanted.weekday&&written.hour==wanted.hour&&written.minute==wanted.minute&&written.second==wanted.second);
+ assert(seed_epoch==expected_epoch+(tick?1:0)&&native_epoch==seed_epoch&&native_valid);
+ const uint8_t *basis=edited?basis_edited:tick?basis_tick:which("fold-first")?basis_fold_first:which("fold-second")?basis_fold_second:which("fold-second-utc")?basis_fold_utc:utc?basis_utc:basis_local;
+ assert(sizes[7]==12&&!memcmp(values[7],basis,12));
+
+ assert(rtc_writes==1&&rtc_reads==1&&seeds==1&&submitted==1);
+ assert(snt_last_result.rtc_outcome==PORTABLE_SET_TIME_CONFIRMED&&snt_last_result.native.verified&&snt_last_result.metadata_outcome==PORTABLE_SET_TIME_CONFIRMED);
+ assert(!legacy_puts&&!checkpoint_owned&&!retained);
+ assert(word(values[7]+4)==expected_epoch+(tick?1:0));
+ assert(snt_last_result.verified_utc_epoch==expected_epoch+(tick?1:0));
+ assert(snt_last_result.rtc_tick_accepted==tick);
+ assert(values[7][3]==(which("save-utc")||which("fold-second-utc")));
+}
+int main(int argc,char **argv) {
