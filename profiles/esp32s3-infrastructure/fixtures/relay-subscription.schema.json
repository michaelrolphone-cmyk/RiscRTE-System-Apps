{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "channel": {
      "enum": [
        "capabilities.events",
        "bpmn.events",
        "scheduler.events",
        "rhizome.events"
      ]
    },
    "match": {
      "type": "object",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 8
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "op": {
                "enum": [
                  "eq",
                  "prefix"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 0,
                "maxLength": 256
              }
            },
            "required": [
              "path",
              "op",
              "value"
            ],
            "additionalProperties": false
          },
          "maxItems": 4
        }
      },
      "required": [
        "types",
        "filters"
      ],
      "additionalProperties": false
    },
    "url": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "auth": {
      "type": "object",
      "properties": {
        "header": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "credential_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "header",
        "credential_ref"
      ],
      "additionalProperties": false
    },
    "signing_credential_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "enabled": {
      "type": "boolean"
    },
    "channels": {
      "type": "array",
      "items": {
        "enum": [
          "capabilities.events",
          "bpmn.events",
          "scheduler.events",
          "rhizome.events"
        ]
      },
      "maxItems": 4
    },
    "destination": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "webhook",
            "mcp_events"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "kind",
        "origin"
      ],
      "additionalProperties": false
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revoked": {
      "type": "boolean"
    },
    "fanout_group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "invocation": {
      "type": "object",
      "properties": {
        "routine_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "routine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assignment_ref": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effect_key": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        }
      },
      "required": [
        "routine_id",
        "routine_version",
        "assignment_ref",
        "deadline",
        "effect_key"
      ],
      "additionalProperties": false
    },
    "previous_signing_credential_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rotation_until": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "match",
    "url",
    "enabled"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "channel"
      ]
    },
    {
      "required": [
        "channels"
      ]
    }
  ]
}
