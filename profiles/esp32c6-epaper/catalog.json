{
  "contract": {
    "capability_id": "display.epaper.frame",
    "api_version": 1,
    "description": "Convergent 800x480 UC8179 black/white framebuffer; immutable artifact transfer, complete verification before full refresh. Native 1-bit tones only.",
    "frame_spec": {
      "format": "mono1-msb-black1",
      "width": 800,
      "height": 480,
      "stride_bytes": 100,
      "frame_bytes": 48000,
      "bits_per_pixel": 1,
      "tone_levels": 2,
      "tones": {
        "0": "white",
        "1": "black"
      },
      "bit_order": "msb_first",
      "byte_order": "row_major",
      "origin": "top_left",
      "row_direction": "top_to_bottom",
      "column_direction": "left_to_right",
      "compression": "none",
      "rotation_degrees": 0,
      "media_type": "application/vnd.riscrte.epaper.mono1",
      "refresh_modes": [
        "full"
      ],
      "max_inflight_frames": 1,
      "completion_evidence": "controller_busy_asserted_then_released; optical verification unavailable",
      "transfer": {
        "kind": "capabilities_artifact",
        "sha256_required": true,
        "participant_scope_required": true,
        "size_bytes": 48000
      },
      "desired": {
        "delivery_semantics": "convergent",
        "slot": "frame",
        "coalesces_superseded_frames": true
      }
    },
    "operations": {
      "render": {
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "width",
            "height",
            "stride_bytes",
            "artifact"
          ],
          "properties": {
            "format": {
              "const": "mono1-msb-black1"
            },
            "width": {
              "const": 800
            },
            "height": {
              "const": 480
            },
            "stride_bytes": {
              "const": 100
            },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^artifact_[a-zA-Z0-9_]+$",
                  "maxLength": 100
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "size_bytes": {
                  "const": 48000
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "status",
            "sha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "rendered",
                "failed",
                "unknown"
              ]
            },
            "sha256": {
              "type": "string"
            }
          }
        },
        "evidence_schema": {
          "type": "object"
        },
        "execution_modes": [
          "desired_state"
        ],
        "effect_semantics": "convergent_state"
      }
    }
  },
