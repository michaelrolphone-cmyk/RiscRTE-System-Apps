  "blocking_dependencies": [
    {
      "id": "portable_layout_raster",
      "finding": "A physical-size framebuffer does not remove 240-wide logical pixel expansion. Native-sized primitives, text, icons and coordinates must be coherent."
    },
    {
      "id": "shared_controls",
      "finding": "Quick uses 240-wide raster rows and logical height >=240. Adapter bounds are 160..1024 on both physical axes and the native-height path rejects logical height <240. 480\u00d7320 derives logical 240\u00d7160 and fails full-app opening even if the new Springboard renderer alone handles it."
    },
    {
      "id": "surface_ownership",
      "finding": "Preserve padded native strides, minimum sizes, overflow checks, single submit token, cancellation and retained/uncertain-provider ownership. Native layout does not authorize simplifying service/lifecycle rules."
    },
    {
      "id": "scene_host_profile_text",
      "finding": "Native capability geometry is present in the reviewed host, but exact shipped host/profile/text-input closure and bitmap font quality need qualification. Reviewed host bounds are 160..2048; font scale 1..4 and fixed glyph bitmaps remain."
    },
    {
      "id": "viewer_canvas",
      "finding": "Viewer canvas is capability-sized within 160..1200 bounds; rotation and monochrome working/snapshot copies do not imply reduced-resolution scaling. Verify kind==CANVAS_VIEWER and exact .43 build."
    },
    {
      "id": "font_icon_sources",
      "finding": "Frozen font/icon atlases and 5\u00d77 bitmap expansion need independent review. Springboard-only native font work does not migrate other apps or shared Quick assets."
    },
