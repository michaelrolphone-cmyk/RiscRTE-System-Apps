#!/usr/bin/env python3
import subprocess,sys
p=subprocess.run(['/usr/bin/nm',*sys.argv[1:]],text=True,capture_output=True)
for row in p.stdout.splitlines():
 parts=row.split()
 if len(parts)==3 and parts[-1].startswith('_'):parts[-1]=parts[-1][1:];row=' '.join(parts)
 print(row)
sys.stderr.write(p.stderr);sys.exit(p.returncode)
