diff --git a/lib/PortableApps/include/PortableSerialClient.h b/lib/PortableApps/include/PortableSerialClient.h
new file mode 100644
index 0000000..c62e355
--- /dev/null
+++ b/lib/PortableApps/include/PortableSerialClient.h
@@ -0,0 +1,76 @@
+#ifndef PORTABLE_SERIAL_CLIENT_H
+#define PORTABLE_SERIAL_CLIENT_H
+/* App-local, opt-in stream client, not a monitor application or raw serial ABI.
+ * Build PortableSerialClient.c with PORTABLE_SERIAL_STREAMS. Use only on the
+ * owner task, within one invocation. Init a fresh object once; never copy,
+ * reinitialize a live/retained object, mutate its fields, or persist handles. */
+#include "RiscStreamClientV1.h"
+#include "RiscSerialStreamSessionV1.h"
+#include "RiscSerialPortV1.h"
+#include "T5SerialPortApi.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define PSC_CHUNK RISC_STREAM_CHUNK_V1
+#define PSC_QUEUE_CAPACITY PSC_CHUNK
+#define PSC_STALL_MS 2000u
+enum {
+ PSC_OK=0, PSC_AGAIN=1, PSC_EOF=2,
+ PSC_INVALID=-1, PSC_DENIED=-2, PSC_LIMIT=-3, PSC_UNSUPPORTED=-4,
+ PSC_IO=-5, PSC_DISCONNECTED=-6, PSC_CANCELLED=-7, PSC_BUSY=-8,
+ PSC_CLOSED=-9, PSC_TIMEOUT=-10, PSC_RETAINED=-11
+};
+typedef struct portable_serial_client {
+ const struct portable_serial_client *self;
+ const risc_runtime_api_v1 *runtime;
+ risc_stream_client_v1 streams;
+ risc_runtime_capability_v1 grant;
+ risc_serial_device_v1 inventory[RISC_SERIAL_INVENTORY_MAX_DEVICES];
+ size_t inventory_count;
+ uint64_t instance,device,generation;
+ risc_stream_session_t session;
+ risc_stream_client_handle_t rx_stream,tx_stream;
+ t5_serial_config_t config;
+ uint64_t rx_bytes,tx_bytes; /* Saturating accepted-byte counters, not flush. */
+ uint8_t queue[PSC_QUEUE_CAPACITY];
+ size_t queued,sent;
+ uint32_t queued_at,control_budget_ms;
+ int result;
+ bool initialized,stream_mode,connected,cleanup_required,halted,inventory_loaded,dtr,rts;
+} portable_serial_client;
+/* Init does not acquire a provider. Zero instance requires exactly one
+ * authorized provider, as defined by Runtime; it never picks a provider. */
+bool portable_serial_init(portable_serial_client *,const risc_runtime_api_v1 *);
+bool portable_serial_init_instance(portable_serial_client *,const risc_runtime_api_v1 *,uint64_t instance);
+/* Total allocated stream-control budget per public operation, including its
+ * one optional error close, is 1..1000 ms. Open needs at least 2 ms because
+ * Runtime may spend the same sub-budget again on its internal open rollback.
+ * No retries, sleeps or yields. These are cooperative callback budgets, not
+ * preemption or a wall-clock bound on capability acquisition/release. */
+bool portable_serial_set_control_budget(portable_serial_client *,uint32_t milliseconds);
+/* Acquire the selected capability and copy a complete, validated inventory.
+ * Failed/partial/malformed snapshots return IO and leave the prior snapshot
+ * untouched. No endpoint is opened and no device is automatically selected. */
+bool portable_serial_refresh(portable_serial_client *);
+/* Explicit index into the last successful snapshot. If none is loaded, take
+ * one snapshot first. Open passes its exact device AND generation to Runtime;
+ * it never refreshes/rebinds an already selected index or retries on detach. */
+bool portable_serial_open(portable_serial_client *,size_t index,const t5_serial_config_t *);
+bool portable_serial_configure(portable_serial_client *,const t5_serial_config_t *);
+bool portable_serial_control(portable_serial_client *,bool dtr,bool rts);
+/* Copy one bounded NUL-terminated line plus CRLF. Only one outstanding line.
+ * now_ms is caller-supplied same-boot uint32 monotonic time; wraps are allowed.
+ * A stalled queue expires 2000 ms after last accepted progress. Cancellation
+ * discards only unaccepted app bytes, never bytes already accepted by Runtime. */
+bool portable_serial_queue(portable_serial_client *,const char *line,uint32_t now_ms);
+size_t portable_serial_tick(portable_serial_client *,void *rx,size_t capacity,uint32_t now_ms);
+void portable_serial_cancel(portable_serial_client *);
+/* Idempotent after a clean close; reconnect requires another explicit open.
+ * On cleanup_required: return promptly from the invocation, requesting its
+ * retain_invocation fence if needed. Never close/release/retry/free this client
+ * or poll/yield providers. This client never attempts cleanup after RETAINED. */
+bool portable_serial_close(portable_serial_client *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/lib/PortableApps/include/RiscSerialPortV1.h b/lib/PortableApps/include/RiscSerialPortV1.h
new file mode 100644
index 0000000..16b59c5
--- /dev/null
+++ b/lib/PortableApps/include/RiscSerialPortV1.h
@@ -0,0 +1,78 @@
+#pragma once
+/* Generic semantic serial.port@1 provider ABI. Hardware-specific protocols,
+ * host enumeration and transport identity belong to the installed provider.
+ * The runtime can inspect this interface without including USB headers. */
+#include "RiscProviderV2.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define RISC_SERIAL_PORT_API_V1 1u
+#define RISC_SERIAL_INVENTORY_MAX_DEVICES 8u
+
+typedef struct {
+    uint32_t api_version;
+    uint32_t struct_size;
+    uint64_t (*open)(uint64_t provider_device);
+    bool (*configure)(uint64_t session, uint32_t baud, uint8_t data_bits,
+                      uint8_t parity, uint8_t stop_bits);
+    bool (*control_lines)(uint64_t session, bool dtr, bool rts);
+    int32_t (*read)(uint64_t session, uint8_t *dst, size_t capacity,
+                    uint32_t timeout_ms);
+    int32_t (*write)(uint64_t session, const uint8_t *src, size_t length,
+                     uint32_t timeout_ms);
+    bool (*close)(uint64_t session);
+} risc_serial_port_api_v1;
+
+/* Optional append-only read-only probe. 1=match, 0=definite nonmatch,
+ * negative=uncertain; an uncertain result MUST NOT be treated as detach. */
+typedef struct {
+    risc_serial_port_api_v1 serial;
+    int32_t (*probe)(uint64_t provider_device);
+} risc_serial_port_discovery_v1;
+
+/* Transport values match the versioned generic device-registry vocabulary.
+ * A protocol ELF, not the framework, identifies its actual transport. */
+enum {
+    RISC_SERIAL_TRANSPORT_INTERNAL = 0,
+    RISC_SERIAL_TRANSPORT_UART = 1,
+    RISC_SERIAL_TRANSPORT_USB = 2,
+    RISC_SERIAL_TRANSPORT_BLE = 3,
+    RISC_SERIAL_TRANSPORT_I2C = 4,
+    RISC_SERIAL_TRANSPORT_SPI = 5,
+    RISC_SERIAL_TRANSPORT_GPIO = 6,
+    RISC_SERIAL_TRANSPORT_LORA = 7,
+    RISC_SERIAL_TRANSPORT_IP = 8
+};
+
+typedef struct {
+    /* Both tokens are provider-owned, nonzero and stable while connected.
+     * generation changes on each physical reconnect, even at a reused port.
+     * Never publish these raw tokens as application device handles. */
+    uint64_t provider_device;
+    uint64_t generation;
+    uint8_t transport;
+    uint8_t reserved[7];
+} risc_serial_device_v1;
+
+/* Provider-originated bounded inventory; no direct host/device work in core.
+ * On success, *inout_count is the exact number of complete records written.
+ * Insufficient capacity returns false and required count, WITHOUT writing a
+ * partial inventory. Failed enumeration/identity is UNKNOWN: the runtime must
+ * neither publish a healthy empty set nor silently revoke existing leases.
+ * Implementations must perform no claims, controls or data transfers here.
+ * The provider grant must remain pinned while any announced device is live. */
+typedef struct {
+    risc_serial_port_discovery_v1 discovery;
+    bool (*snapshot)(risc_serial_device_v1 *out, size_t *inout_count);
+} risc_serial_port_inventory_v1;
+/* Optional provider-owned stream endpoints for an already-open session.
+ * The provider owns publication, bounded physical pumping, and close. A
+ * false return fails acquisition; core must not fall back to raw read/write.
+ * Consumer grants are issued separately against the exact capability lease. */
+typedef struct {
+    risc_serial_port_inventory_v1 inventory;
+    bool (*endpoints)(uint64_t session, uint32_t *rx, uint32_t *tx);
+} risc_serial_port_streams_v1;
+#ifdef __cplusplus
+}
+#endif
diff --git a/lib/PortableApps/include/RiscSerialStreamSessionV1.h b/lib/PortableApps/include/RiscSerialStreamSessionV1.h
new file mode 100644
index 0000000..9fb56fb
--- /dev/null
+++ b/lib/PortableApps/include/RiscSerialStreamSessionV1.h
@@ -0,0 +1,37 @@
+#pragma once
+/* Interpreted by the app and serial provider adapter;
+ * generic Runtime copies these bytes and never includes this header. */
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define RISC_SERIAL_STREAM_REQUEST_V1 1u
+typedef struct {
+  uint32_t baud_rate;
+  uint8_t data_bits, parity, stop_bits, flow_control;
+} risc_serial_stream_config_v1;
+typedef struct {
+  uint32_t api_version, struct_size;
+  uint64_t provider_device, device_generation;
+  risc_serial_stream_config_v1 config;
+} risc_serial_stream_open_v1;
+enum {
+  RISC_SERIAL_STREAM_CONFIGURE=1,
+  RISC_SERIAL_STREAM_CONTROL_LINES=2,
+  RISC_SERIAL_STREAM_CHECK_DEVICE=3
+};
+typedef struct {
+  uint32_t api_version, struct_size, operation, reserved;
+  union {
+    risc_serial_stream_config_v1 config;
+    struct { uint8_t dtr, rts, reserved[6]; } lines;
+    uint8_t zero[8];
+  } value;
+} risc_serial_stream_call_v1;
+/* All three calls return status only, with reply_size=0. CHECK_DEVICE requires
+ * a complete valid inventory: exact device+generation => OK; valid absence =>
+ * DISCONNECTED; failed/malformed/partial inventory => IO, preserving custody.
+ */
+#ifdef __cplusplus
+}
+#endif
diff --git a/lib/PortableApps/include/RiscStreamClientV1.h b/lib/PortableApps/include/RiscStreamClientV1.h
new file mode 100644
index 0000000..bb33457
--- /dev/null
+++ b/lib/PortableApps/include/RiscStreamClientV1.h
@@ -0,0 +1,53 @@
+#pragma once
+/* Invocation-bound byte streams; the Runtime owns provider-session custody. */
+#include "RiscRuntimeV1.h"
+#include "RiscStreamResultV1.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define RISC_STREAM_CLIENT_API_V1 1u
+#define RISC_STREAM_CHUNK_V1 512u
+#define RISC_STREAM_BUFFER_MAX_V1 4096u
+#define RISC_STREAM_CONTROL_MAX_MS_V1 1000u
+typedef uint64_t risc_stream_session_t;
+typedef uint64_t risc_stream_client_handle_t;
+typedef struct {
+  uint32_t struct_size, reserved;
+  risc_stream_session_t session;
+  risc_stream_client_handle_t rx, tx;
+} risc_stream_opened_v1;
+typedef struct {
+  uint32_t struct_size, rights, capacity, buffered, high_water;
+  int32_t terminal;
+  uint64_t bytes_read, bytes_written;
+} risc_stream_client_info_v1;
+/* All methods are owner-task/invocation bound. Open also requires the exact
+ * live capability grant; session/stream handles are Runtime-issued opaque IDs.
+ * Control budgets are 1..1000 ms; requests/replies are copied and <=512 bytes.
+ * Read/write initialize count to zero and transfer at most min(request,512).
+ * Partial progress is OK; empty/full is AGAIN; drained graceful RX is EOF.
+ * Writes count accepted queue bytes, never a physical flush guarantee.
+ * RETAINED requires prompt return without cleanup, polling, frees or retries. */
+typedef struct risc_stream_client_v1 {
+  uint32_t api_version, struct_size;
+  uint64_t context; /* Runtime-minted, unique current invocation, never an owner input. */
+  int32_t (*open)(uint64_t context, const risc_runtime_capability_v1 *grant,
+      const void *request, uint32_t request_size, uint32_t budget_ms,
+      risc_stream_opened_v1 *out);
+  int32_t (*call)(uint64_t context, risc_stream_session_t session,
+      const void *request, uint32_t request_size, uint32_t budget_ms,
+      void *reply, uint32_t reply_capacity, uint32_t *reply_size);
+  int32_t (*close)(uint64_t context, risc_stream_session_t session,
+      uint32_t budget_ms);
+  int32_t (*read)(uint64_t context, risc_stream_client_handle_t stream,
+      void *data, uint32_t capacity, uint32_t *count);
+  int32_t (*write)(uint64_t context, risc_stream_client_handle_t stream,
+      const void *data, uint32_t length, uint32_t *count);
+  int32_t (*info)(uint64_t context, risc_stream_client_handle_t stream,
+      risc_stream_client_info_v1 *out);
+} risc_stream_client_v1;
+/* Obtain a copied table using Runtime.stream_client. A table copy never extends
+ * its invocation. No API accepts raw provider session or endpoint IDs. */
+#ifdef __cplusplus
+}
+#endif
diff --git a/lib/PortableApps/include/RiscStreamResultV1.h b/lib/PortableApps/include/RiscStreamResultV1.h
new file mode 100644
index 0000000..4bdf0f5
--- /dev/null
+++ b/lib/PortableApps/include/RiscStreamResultV1.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <stdint.h>
+/* Existing T5 result numbers are preserved. RETAINED is additive. */
+enum {
+  RISC_STREAM_OK=0, RISC_STREAM_AGAIN=1, RISC_STREAM_EOF=2,
+  RISC_STREAM_INVALID=-1, RISC_STREAM_DENIED=-2, RISC_STREAM_LIMIT=-3,
+  RISC_STREAM_UNSUPPORTED=-4, RISC_STREAM_IO=-5,
+  RISC_STREAM_DISCONNECTED=-6, RISC_STREAM_CANCELLED=-7,
+  RISC_STREAM_BUSY=-8, RISC_STREAM_CLOSED=-9, RISC_STREAM_TIMEOUT=-10,
+  RISC_STREAM_RETAINED=-11
+};
+enum { RISC_STREAM_READ=1, RISC_STREAM_WRITE=2 };
diff --git a/lib/PortableApps/src/PortableSerialClient.c b/lib/PortableApps/src/PortableSerialClient.c
new file mode 100644
index 0000000..4d1d3c8
--- /dev/null
+++ b/lib/PortableApps/src/PortableSerialClient.c
@@ -0,0 +1,265 @@
+#include "PortableSerialClient.h"
+#include <string.h>
+
+static bool result(portable_serial_client *c,int code) {
+ if(c)c->result=code;
+ return code==PSC_OK;
+}
+static bool retained(portable_serial_client *c) {
+ c->cleanup_required=true;c->halted=true;c->connected=false;
+ return result(c,PSC_RETAINED);
+}
+static bool object(portable_serial_client *c) {
+ if(!c)return false;
+ if(c->self!=c || !c->initialized)return result(c,PSC_INVALID);
+ if(c->halted || c->cleanup_required)return false;
+ return true;
+}
+static bool table_valid(const risc_stream_client_v1 *s) {
+ return s->api_version==RISC_STREAM_CLIENT_API_V1 && s->struct_size>=sizeof(*s) &&
+        s->context && s->open && s->call && s->close && s->read && s->write && s->info;
+}
+/* Verify invocation before dereferencing a borrowed capability table. Runtime
+ * also checks every stream operation, including stale/forged handle use. */
+static bool current(portable_serial_client *c) {
+ if(!object(c))return false;
+ risc_stream_client_v1 now={.struct_size=sizeof(now)};
+ if(!c->runtime->stream_client(&now) || !table_valid(&now) ||
+    now.context!=c->streams.context) {
+  c->halted=true;
+  if(c->grant.api || c->session)return retained(c);
+  return result(c,PSC_DENIED);
+ }
+ return true;
+}
+static bool configuration(const t5_serial_config_t *v) {
+ return v && v->baud_rate>=300 && v->baud_rate<=3000000 &&
+        v->data_bits>=5 && v->data_bits<=8 && v->parity<=T5_SERIAL_PARITY_SPACE &&
+        (v->stop_bits==1 || v->stop_bits==2) && v->flow_control==T5_SERIAL_FLOW_NONE;
+}
+static bool status_valid(int rc) {return rc>=PSC_RETAINED && rc<=PSC_EOF;}
+static bool control_status(int rc) {return rc>=PSC_RETAINED && rc<=PSC_OK;}
+static bool grant_valid(const risc_runtime_capability_v1 *g) {
+ return g->struct_size==sizeof(*g) && g->slot && g->generation && g->api;
+}
+static bool grant_empty(const risc_runtime_capability_v1 *g) {
+ return g->struct_size==sizeof(*g) && !g->slot && !g->generation && !g->api;
+}
+static bool release_grant(portable_serial_client *c) {
+ if(!c->grant.api)return true;
+ risc_runtime_capability_v1 copy=c->grant;
+ if(!c->runtime->release(&copy) || !grant_empty(&copy))return retained(c);
+ c->grant=copy;c->inventory_count=0;c->inventory_loaded=false;
+ return true;
+}
+static void discard(portable_serial_client *c) {c->queued=c->sent=0;}
+/* No retry even for BUSY/CLOSED: these do not prove physical teardown. Keep
+ * original tokens as evidence if either close or release is uncertain. */
+static bool close_with_budget(portable_serial_client *c,uint32_t budget,int final) {
+ if(c->session) {
+  if(!budget)return retained(c);
+  int rc=c->streams.close(c->streams.context,c->session,budget);
+  if(rc!=PSC_OK)return retained(c);
+  c->session=0;c->rx_stream=c->tx_stream=0;c->connected=false;
+ }
+ if(!release_grant(c))return false;
+ c->connected=false;c->device=c->generation=0;c->dtr=c->rts=false;
+ c->inventory_count=0;c->inventory_loaded=false;discard(c);
+ return result(c,final);
+}
+static uint32_t operation_budget(const portable_serial_client *c) {
+ /* Reserve the remainder for at most one checked close. Even a one-ms budget
+  * is valid; if it is consumed, uncertain custody must be retained. */
+ return (c->control_budget_ms+1u)/2u;
+}
+static int call(portable_serial_client *c,risc_serial_stream_call_v1 *request,uint32_t budget) {
+ uint32_t actual=0;
+ int rc=c->streams.call(c->streams.context,c->session,request,sizeof(*request),budget,0,0,&actual);
+ if(rc==PSC_RETAINED || !control_status(rc) || actual) {
+  (void)retained(c);return PSC_RETAINED;
+ }
+ return rc;
+}
+static risc_serial_stream_config_v1 stream_config(const t5_serial_config_t *v) {
+ risc_serial_stream_config_v1 out={v->baud_rate,v->data_bits,v->parity,v->stop_bits,v->flow_control};
+ return out;
+}
+static void add(uint64_t *total,uint32_t n) {
+ *total=UINT64_MAX-*total<n?UINT64_MAX:*total+n;
+}
+bool portable_serial_init_instance(portable_serial_client *c,const risc_runtime_api_v1 *rt,uint64_t instance) {
+ if(!c)return false;
+ memset(c,0,sizeof(*c));c->self=c;c->control_budget_ms=RISC_STREAM_CONTROL_MAX_MS_V1;
+ c->instance=instance;c->grant.struct_size=sizeof(c->grant);
+#ifndef PORTABLE_SERIAL_STREAMS
+ (void)rt;return result(c,PSC_UNSUPPORTED);
+#else
+ if(!rt || rt->api_version!=RISC_RUNTIME_API_V1 ||
+    rt->struct_size<RISC_RUNTIME_STREAM_CLIENT_V1_SIZE || !rt->acquire || !rt->release || !rt->stream_client)
+  return result(c,PSC_UNSUPPORTED);
+ c->streams.struct_size=sizeof(c->streams);
+ if(!rt->stream_client(&c->streams) || !table_valid(&c->streams))return result(c,PSC_UNSUPPORTED);
+ c->runtime=rt;c->initialized=true;c->stream_mode=true;
+ return result(c,PSC_OK);
+#endif
+}
+bool portable_serial_init(portable_serial_client *c,const risc_runtime_api_v1 *rt) {
+ return portable_serial_init_instance(c,rt,0);
+}
+bool portable_serial_set_control_budget(portable_serial_client *c,uint32_t ms) {
+ if(!object(c))return false;
+ if(!ms || ms>RISC_STREAM_CONTROL_MAX_MS_V1)return result(c,PSC_INVALID);
+ c->control_budget_ms=ms;return result(c,PSC_OK);
+}
+bool portable_serial_refresh(portable_serial_client *c) {
+ if(!current(c))return false;
+ if(c->session)return result(c,PSC_BUSY);
+ if(!c->grant.api) {
+  risc_runtime_capability_v1 g={.struct_size=sizeof(g)};
+  bool ok=c->runtime->acquire(T5_SERIAL_PORT_CAPABILITY,RISC_SERIAL_PORT_API_V1,c->instance,&g);
+  c->grant=g;
+  if(!ok) {
+   if(!grant_empty(&g))return retained(c);
+   /* Runtime's getter is provider-free and is unavailable after a retention
+    * fence. Only a live same-invocation table proves an empty refusal clean.
+    * This is not a provider retry or cleanup attempt. */
+   risc_stream_client_v1 now={.struct_size=sizeof(now)};
+   if(!c->runtime->stream_client(&now) || !table_valid(&now) || now.context!=c->streams.context)
+    return retained(c);
+   return result(c,PSC_DENIED);
+  }
+  if(!grant_valid(&g))return retained(c);
+ }
+ if(!current(c))return false;
+ const risc_serial_port_inventory_v1 *api=c->grant.api;
+ uint32_t header[2];memcpy(header,api,sizeof(header));
+ if(header[0]!=RISC_SERIAL_PORT_API_V1 || header[1]<sizeof(*api) || !api->snapshot) {
+  (void)close_with_budget(c,c->control_budget_ms,PSC_UNSUPPORTED);return false;
+ }
+ risc_serial_device_v1 snapshot[RISC_SERIAL_INVENTORY_MAX_DEVICES]={0};
+ size_t count=RISC_SERIAL_INVENTORY_MAX_DEVICES;
+ if(!api->snapshot(snapshot,&count) || count>RISC_SERIAL_INVENTORY_MAX_DEVICES)return result(c,PSC_IO);
+ for(size_t i=0;i<count;i++) {
+  if(!snapshot[i].provider_device || !snapshot[i].generation || snapshot[i].transport>RISC_SERIAL_TRANSPORT_IP)
+   return result(c,PSC_IO);
+  for(size_t b=0;b<sizeof(snapshot[i].reserved);b++)if(snapshot[i].reserved[b])return result(c,PSC_IO);
+  for(size_t j=0;j<i;j++)if(snapshot[i].provider_device==snapshot[j].provider_device)return result(c,PSC_IO);
+ }
+ memcpy(c->inventory,snapshot,sizeof(snapshot));c->inventory_count=count;c->inventory_loaded=true;
+ return result(c,PSC_OK);
+}
+bool portable_serial_open(portable_serial_client *c,size_t index,const t5_serial_config_t *config) {
+ if(!object(c))return false;
+ if(!configuration(config) || index>=RISC_SERIAL_INVENTORY_MAX_DEVICES || c->control_budget_ms<2u)
+  return result(c,PSC_INVALID);
+ if(c->connected || c->session)return result(c,PSC_BUSY);
+ if(!current(c))return false;
+ if(!c->inventory_loaded && !portable_serial_refresh(c))return false;
+ if(index>=c->inventory_count)return result(c,PSC_DISCONNECTED);
+ risc_serial_device_v1 selected=c->inventory[index];
+ risc_serial_stream_open_v1 request={RISC_SERIAL_STREAM_REQUEST_V1,sizeof(request),
+     selected.provider_device,selected.generation,stream_config(config)};
+ risc_stream_opened_v1 opened={.struct_size=sizeof(opened)};
+ /* The pinned broker can spend its entire budget again on one internal
+  * grant-rollback close. Allocate both parts here, without changing its ABI. */
+ int rc=c->streams.open(c->streams.context,&c->grant,&request,sizeof(request),c->control_budget_ms/2u,&opened);
+ if(rc==PSC_RETAINED)return retained(c);
+ if(!control_status(rc) || opened.struct_size!=sizeof(opened) || opened.reserved ||
+    (rc!=PSC_OK && (opened.session || opened.rx || opened.tx)))return retained(c);
+ if(rc!=PSC_OK) {
+  if(!release_grant(c))return false;
+  return result(c,rc);
+ }
+ if(!opened.session || !opened.rx || !opened.tx || opened.rx==opened.tx ||
+    opened.session==opened.rx || opened.session==opened.tx)return retained(c);
+ c->session=opened.session;c->rx_stream=opened.rx;c->tx_stream=opened.tx;
+ c->device=selected.provider_device;c->generation=selected.generation;c->config=*config;
+ c->connected=true;c->dtr=c->rts=false;discard(c);
+ return result(c,PSC_OK);
+}
+static bool live(portable_serial_client *c) {
+ if(!current(c))return false;
+ return c->connected && c->session?true:result(c,PSC_CLOSED);
+}
+static bool control_result(portable_serial_client *c,int rc) {
+ if(rc==PSC_RETAINED)return false;
+ if(rc==PSC_OK)return result(c,PSC_OK);
+ /* A failed framing/line change is not silently retried on an uncertain
+  * physical configuration. Close once within the remaining control budget. */
+ (void)close_with_budget(c,c->control_budget_ms-operation_budget(c),rc);
+ return false;
+}
+bool portable_serial_configure(portable_serial_client *c,const t5_serial_config_t *config) {
+ if(!object(c))return false;
+ if(!configuration(config))return result(c,PSC_INVALID);
+ if(!live(c))return false;
+ risc_serial_stream_call_v1 request={.api_version=RISC_SERIAL_STREAM_REQUEST_V1,
+     .struct_size=sizeof(request),.operation=RISC_SERIAL_STREAM_CONFIGURE};
+ request.value.config=stream_config(config);
+ if(!control_result(c,call(c,&request,operation_budget(c))))return false;
+ c->config=*config;return true;
+}
+bool portable_serial_control(portable_serial_client *c,bool dtr,bool rts) {
+ if(!live(c))return false;
+ risc_serial_stream_call_v1 request={.api_version=RISC_SERIAL_STREAM_REQUEST_V1,
+     .struct_size=sizeof(request),.operation=RISC_SERIAL_STREAM_CONTROL_LINES};
+ request.value.lines.dtr=dtr;request.value.lines.rts=rts;
+ if(!control_result(c,call(c,&request,operation_budget(c))))return false;
+ c->dtr=dtr;c->rts=rts;return true;
+}
+bool portable_serial_queue(portable_serial_client *c,const char *line,uint32_t now) {
+ if(!object(c))return false;
+ if(!line)return result(c,PSC_INVALID);
+ if(!c->connected)return result(c,PSC_CLOSED);
+ if(c->queued)return result(c,PSC_BUSY);
+ size_t length=0;
+ while(length<=PSC_QUEUE_CAPACITY-2u && line[length])++length;
+ if(length>PSC_QUEUE_CAPACITY-2u)return result(c,PSC_LIMIT);
+ if(length)memcpy(c->queue,line,length);
+ c->queue[length++]='\r';c->queue[length++]='\n';
+ c->queued=length;c->sent=0;c->queued_at=now;
+ return result(c,PSC_OK);
+}
+static bool transfer_result(portable_serial_client *c,int rc,uint32_t n,uint32_t bound) {
+ if(rc==PSC_RETAINED || !status_valid(rc) || n>bound || (rc!=PSC_OK && n) || (rc==PSC_OK && !n))
+  return retained(c);
+ if(rc==PSC_OK || rc==PSC_AGAIN || rc==PSC_BUSY)return true;
+ (void)close_with_budget(c,c->control_budget_ms-operation_budget(c),rc);return false;
+}
+size_t portable_serial_tick(portable_serial_client *c,void *rx,size_t capacity,uint32_t now) {
+ if(!object(c))return 0;
+ if(!rx && capacity){(void)result(c,PSC_INVALID);return 0;}
+ if(!live(c))return 0;
+ risc_serial_stream_call_v1 check={.api_version=RISC_SERIAL_STREAM_REQUEST_V1,
+     .struct_size=sizeof(check),.operation=RISC_SERIAL_STREAM_CHECK_DEVICE};
+ int rc=call(c,&check,operation_budget(c));
+ if(rc==PSC_RETAINED)return 0;
+ if(rc!=PSC_OK) {
+  if(rc==PSC_IO || rc==PSC_AGAIN || rc==PSC_BUSY){(void)result(c,rc);return 0;}
+  (void)close_with_budget(c,c->control_budget_ms-operation_budget(c),rc);return 0;
+ }
+ bool timeout=c->queued && (uint32_t)(now-c->queued_at)>=PSC_STALL_MS;
+ if(timeout)discard(c);
+ if(c->queued) {
+  uint32_t n=0,length=(uint32_t)(c->queued-c->sent);
+  rc=c->streams.write(c->streams.context,c->tx_stream,c->queue+c->sent,length,&n);
+  if(!transfer_result(c,rc,n,length))return 0;
+  if(n) {c->sent+=n;add(&c->tx_bytes,n);c->queued_at=now;}
+  if(c->sent==c->queued)discard(c);
+ }
+ uint32_t n=0,bound=capacity>PSC_CHUNK?PSC_CHUNK:(uint32_t)capacity;
+ if(bound) {
+  rc=c->streams.read(c->streams.context,c->rx_stream,rx,bound,&n);
+  if(!transfer_result(c,rc,n,bound))return 0;
+  add(&c->rx_bytes,n);
+ }
+ (void)result(c,timeout?PSC_TIMEOUT:PSC_OK);return n;
+}
+void portable_serial_cancel(portable_serial_client *c) {
+ if(!object(c))return;
+ discard(c);(void)result(c,PSC_CANCELLED);
+}
+bool portable_serial_close(portable_serial_client *c) {
+ if(!current(c))return false;
+ return close_with_budget(c,c->control_budget_ms,PSC_OK);
+}
