From 5843d1bf2079e66f837aec5eb03a1f15b9a95ae7 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 21 Oct 2026 07:43:11 -0600
Subject: [PATCH 2/2] Preserve terminal suffix when backspace follows carriage
 return

---
 Apps/serial_monitor.c                  | 9 ++++++++-
 test/native_apps/serial_monitor_test.c | 3 +++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/Apps/serial_monitor.c b/Apps/serial_monitor.c
index 46f9090..c63dae8 100644
--- a/Apps/serial_monitor.c
+++ b/Apps/serial_monitor.c
@@ -90,7 +90,14 @@ static void sm_receive(const unsigned char *bytes,size_t n) {
         unsigned c=bytes[i];
         if(c=='\n')sm_newline();
         else if(c=='\r')sm_column=0;
-        else if(c=='\b') {if(sm_column){--sm_column;sm_lines[sm_head][sm_column]=0;}}
+        else if(c=='\b') {
+            if(sm_column) {
+                --sm_column;
+                char *line=sm_lines[sm_head];
+                /* Erase one cell without discarding later text left by CR. */
+                line[sm_column]=line[sm_column+1u]?' ':0;
+            }
+        }
         else if(c=='\t') {unsigned spaces=4u-sm_column%4u;while(spaces--)sm_character(' ');}
         else if(c>=32 && c<127)sm_character((char)c);
         else {sm_character('[');sm_character(hex[c>>4]);sm_character(hex[c&15]);sm_character(']');}
diff --git a/test/native_apps/serial_monitor_test.c b/test/native_apps/serial_monitor_test.c
index 1b9c7e3..02246aa 100644
--- a/test/native_apps/serial_monitor_test.c
+++ b/test/native_apps/serial_monitor_test.c
@@ -122,6 +122,9 @@ static void terminal_test(void) {
     t5_app_input_t in={0};tap(&in,10,150);sm_scroll=0;assert(!sm_event(&in));assert(sm_scroll==1);
     in=(t5_app_input_t){0};assert(!sm_event(&in));tap(&in,240,150);assert(!sm_event(&in));assert(!sm_scroll);
     sm_clear_terminal();assert(sm_count==1 && !sm_scroll && !sm_column && !sm_lines[0][0]);
+    sm_receive((const unsigned char*)"abcde\rXY\b",9);
+    assert(!strcmp(sm_lines[0],"X cde"));
+    sm_receive((const unsigned char*)"z",1);assert(!strcmp(sm_lines[0],"Xzcde"));
     /* Every printable non-space character has a visible glyph, including
      * punctuation and case. ESC is represented as data, never interpreted. */
     for(unsigned c=1;c<95;c++){unsigned bits=0;for(unsigned y=0;y<12;y++)bits|=sm_font[c][y];assert(bits);}
